FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY kit/ kit/
COPY agents/ agents/
COPY dpdp/ dpdp/
COPY connectors/ connectors/
COPY config/ config/

# Ensure output directories exist in the image
RUN mkdir -p output/parity output/migration output/bq_sync

EXPOSE 8090

# Default: DPDP API server
# Override via docker-compose `command:` for the scheduler daemon:
#   command: ["python", "-m", "agents.parity.scheduler"]
CMD ["python", "-m", "dpdp.api"]
