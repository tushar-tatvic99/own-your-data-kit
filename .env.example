# Copy to .env in the repo root (never commit .env)
MATOMO_API_TOKEN=your-matomo-auth-token-here
# Superuser token for "Create Matomo site" in demo console (Your Analytics Setup). Often same as admin MATOMO_API_TOKEN on the VM.
# OYDK_MATOMO_PROVISION_TOKEN=
SLACK_WEBHOOK_URL=
META_ACCESS_TOKEN=

# Parity (and kit) alert email — Gmail: use an app password, not your login password
OYDK_EMAIL_FROM=you@yourdomain.com
OYDK_SMTP_HOST=smtp.gmail.com
OYDK_SMTP_PORT=587
OYDK_SMTP_USER=you@yourdomain.com
OYDK_SMTP_PASS=
# Optional override (comma-separated) instead of config/client.yaml alert_emails
# PARITY_ALERT_EMAILS=

# Demo console — Ask your agent (Matomo Q&A). Without this, rule-based answers still work.
# OYDK_OPENAI_API_KEY=sk-...
# OYDK_OPENAI_MODEL=gpt-4o-mini

# Kit API base URL (demo console probes /health and /audit)
# KIT_API_URL=http://35.234.210.199:8090
